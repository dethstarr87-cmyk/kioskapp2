<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration.
    By default this enforces HTTPS only (correct for a kiosk).
    If your target URL uses HTTP (not recommended), add a domain exception here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
